{
  "name": "astrolumina-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cloudflare": "npm install --include=dev && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "start": "npm run dev",
    "clean": "rm -rf node_modules && rm -rf dist",
    "c_u_i_b": "npm run clean && npm update --ignore-scripts && npm install --include=dev && npm run build",
    "c_u_i_b_d": "npm run c_u_i_b && npm run dev"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@sentry/react": "^10.53.1",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "axios": "^1.7.9",
    "country-state-city": "^3.2.1",
    "dompurify": "^3.4.0",
    "flatpickr": "^4.6.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-flatpickr": "^3.10.13",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-flatpickr": "^3.8.11",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true
  }
}
